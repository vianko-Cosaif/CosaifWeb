{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,route,error,loading,not-found,global-error,template,default}.{ts,tsx}",
    "scripts/**/*.{js,cjs,mjs,ts}",
    "tests/**/*.{ts,tsx}",
    "e2e/**/*.ts",
    "*.config.{js,cjs,mjs,ts,mts}"
  ],
  "project": [
    "src/**/*.{ts,tsx,css,scss,sass}",
    "scripts/**/*.{js,cjs,mjs,ts}",
    "tests/**/*.{ts,tsx}",
    "e2e/**/*.ts"
  ],
  "ignoreBinaries": ["mkcert", "openssl"],
  "ignoreDependencies": ["prettier"]
}
