{
  "name": "cosaif",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3012",
    "dev:https": "next dev -p 3012 --experimental-https",
    "cert:lan": "node scripts/create-lan-cert.mjs",
    "pwa:urls": "node scripts/print-pwa-urls.mjs",
    "dev:https:lan": "npm run cert:lan && next dev -p 3012 -H 0.0.0.0 --experimental-https --experimental-https-key certificates/cosaif-lan-key.pem --experimental-https-cert certificates/cosaif-lan.pem",
    "build": "next build --webpack",
    "build:quality": "node scripts/build-quality.mjs",
    "start": "next start -p 3012",
    "start:local": "node scripts/start-local.mjs",
    "format": "node scripts/format-changed.mjs --write",
    "format:check": "node scripts/format-changed.mjs --check",
    "lint": "eslint",
    "dead-code": "knip",
    "dead-code:files": "knip --include files",
    "dead-code:dependencies": "knip --dependencies",
    "analyze": "node scripts/run-bundle-analyzer.mjs",
    "performance:budget": "node scripts/check-performance-budget.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run dead-code:files && npm run dead-code:dependencies && npm run typecheck && npm test && npm run build:quality && npm run performance:budget -- --quality"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-virtual": "^3.13.12",
    "antd": "^6.5.0",
    "clsx": "^2.1.1",
    "driver.js": "^1.4.0",
    "firebase": "^12.14.0",
    "framer-motion": "^12.23.12",
    "jose": "^6.1.0",
    "lucide-react": "^0.542.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-data-grid": "7.0.0-beta.47",
    "react-dom": "19.2.8",
    "recharts": "^2.12.7",
    "tailwind-merge": "^3.3.1",
    "tone": "^15.1.22",
    "zod": "^4.1.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@next/bundle-analyzer": "16.3.4",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "24.13.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "knip": "6.36.0",
    "postcss": "^8.5.6",
    "prettier": "3.9.7",
    "sass": "^1.93.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
