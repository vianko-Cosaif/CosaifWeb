# Copiar a .env.local. Nunca añadir credenciales reales al repositorio.
# Backend principal (reemplazar por la dirección de tu entorno).
API_ORIGIN=http://localhost:3001
NEXT_PUBLIC_API_BASE=/bff
NEXT_PUBLIC_API_URL=/bff
NEXT_PUBLIC_INCIDENT_API_BASE=/bff
BFF_TIMEOUT_MS=12000
JWT_COOKIE_NAME=token
ROLE_COOKIE_NAME=role
COOKIE_MAX_AGE=604800
# Generar un valor aleatorio independiente del JWT_SECRET del backend.
# Ejemplo: openssl rand -base64 48
SESSION_SECRET=

# Activar en el servidor que centraliza sus logs. Sin cuerpos ni credenciales.
TELEMETRY_ENABLED=false
APP_RELEASE=local

# Las notificaciones son opcionales para entrar.
NEXT_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=false
NEXT_PUBLIC_ENABLE_DEV_NOTIFICATIONS=false
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Dirección pública WSS si se usa un host separado para tiempo real.
REALTIME_PUBLIC_WS_URL=
# Mantener los IDs reales de localidad definidos para tu instalación.
TORREON_LOCALIDAD_IDS=
NEXT_PUBLIC_TORREON_LOCALIDAD_IDS=
